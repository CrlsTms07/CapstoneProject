# Dependencies
node_modules/

# Environment variables (secrets) - copy .env.example instead
.env
.env.*
!.env.example

# Build output
dist/
build/

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Test output
coverage/

# Database dumps / backups (may contain real teacher and user data)
*.dump
*.backup
*.sql.gz
backups/

# Keys / certificates
*.pem
*.key
*.crt

# Uploaded files (anchored so module folders such as modules/exports stay tracked)
/uploads/
/server/uploads/

# Personal editor settings
.vscode/*
!.vscode/extensions.json
.idea/

# Caches
.npm/
.eslintcache
*.local
